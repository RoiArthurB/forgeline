{
 "name": "soft-dark",
 "comment": "The Soft palette for code; CodeContrastTest holds every color to 4.5:1 on its ground.",
 "tokenColors": [
  {
   "settings": {
    "foreground": "#EDEDF0"
   }
  },
  {
   "scope": [
    "punctuation.separator",
    "punctuation.terminator",
    "punctuation.accessor",
    "punctuation.section",
    "punctuation.bracket",
    "punctuation.parenthesis",
    "punctuation.squarebracket",
    "punctuation.curlybrace",
    "punctuation.definition.tag",
    "meta.brace",
    "meta.delimiter",
    "keyword.operator"
   ],
   "settings": {
    "foreground": "#C9C4D6"
   }
  },
  {
   "scope": [
    "keyword",
    "storage",
    "storage.type",
    "storage.modifier",
    "keyword.control",
    "entity.name.tag",
    "support.type.property-name.css"
   ],
   "settings": {
    "foreground": "#FFC062"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.template",
    "string.unquoted",
    "string.regexp",
    "markup.inline.raw",
    "markup.fenced_code",
    "markup.raw",
    "constant.character.escape",
    "support.constant.property-value.css"
   ],
   "settings": {
    "foreground": "#8FD6A8"
   }
  },
  {
   "scope": [
    "constant",
    "constant.numeric",
    "constant.language",
    "constant.character",
    "constant.other",
    "support.constant",
    "variable.other.constant",
    "variable.language",
    "markup.underline.link"
   ],
   "settings": {
    "foreground": "#8CB8FF"
   }
  },
  {
   "scope": [
    "meta.annotation",
    "storage.type.annotation",
    "punctuation.definition.annotation",
    "entity.name.function.decorator",
    "meta.decorator",
    "meta.preprocessor",
    "keyword.control.directive",
    "entity.other.attribute-name",
    "support.type.property-name",
    "meta.object-literal.key",
    "entity.name.tag.yaml",
    "keyword.other.unit",
    "markup.quote"
   ],
   "settings": {
    "foreground": "#C9A7F5"
   }
  },
  {
   "scope": [
    "comment",
    "punctuation.definition.comment",
    "comment.block.documentation"
   ],
   "settings": {
    "foreground": "#9C9BA3"
   }
  },
  {
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#FFC062",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.bold"
   ],
   "settings": {
    "foreground": "#EDEDF0",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.italic"
   ],
   "settings": {
    "foreground": "#EDEDF0",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.strikethrough"
   ],
   "settings": {
    "foreground": "#EDEDF0",
    "fontStyle": "strikethrough"
   }
  },
  {
   "scope": [
    "markup.inserted",
    "meta.diff.header.to-file"
   ],
   "settings": {
    "foreground": "#8FD6A8"
   }
  },
  {
   "scope": [
    "markup.deleted",
    "meta.diff.header.from-file"
   ],
   "settings": {
    "foreground": "#FFC062"
   }
  },
  {
   "scope": [
    "meta.diff.range",
    "meta.diff.index",
    "meta.separator"
   ],
   "settings": {
    "foreground": "#8CB8FF"
   }
  },
  {
   "scope": [
    "meta.diff.header"
   ],
   "settings": {
    "foreground": "#9C9BA3"
   }
  }
 ]
}
