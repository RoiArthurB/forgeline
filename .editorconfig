root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = off
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Composables are named like the things they draw.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Hygiene only: imports, indentation, spacing, blank lines. The rules below would rewrap the code into another style
# (signatures joined or split, arguments one per line, blank lines between when branches); the code keeps its own.
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_blank-line-between-when-conditions = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_enum-wrapping = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_multiline-if-else = disabled
ktlint_standard_multiline-loop = disabled
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_statement-wrapping = disabled
# Trailing commas are welcome, not required: required, an enum ending in `;` gets `OTHER,` then a `;` of its own.
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
# A KDoc stays where its author put it, and a file is named for what it holds rather than its first class.
ktlint_standard_kdoc = disabled
ktlint_standard_filename = disabled
